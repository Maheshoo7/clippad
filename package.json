{
  "name": "clippad",
  "private": true,
  "version": "0.1.0",
  "description": "A fast, private, open-source clipboard history manager for macOS — with a cat.",
  "license": "MIT",
  "author": "G Mahesh (https://github.com/Maheshoo7)",
  "homepage": "https://github.com/Maheshoo7/clippad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maheshoo7/clippad.git"
  },
  "bugs": {
    "url": "https://github.com/Maheshoo7/clippad/issues"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "clipboard-history",
    "macos",
    "menu-bar",
    "tauri",
    "react",
    "rust"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "npm run typecheck && npm test && npm run lint:rust && npm run test:rust",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-store": "^2.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
